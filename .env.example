DB_PORT=5432
DB_USER=POSTGRES_USER
DB_PASSWORD=POSTGRES_PASSWORD
DB_NAME=DB_NAME
DB_HOST=localhost
SECRET=YOUR_SECRET

# Email configuration (optional)
# If MAIL_HOST is not set, password reset links are only printed to the server logs.
# For local development with Docker, use the built-in Mailpit service (see docker-compose.yml).
# For production, configure any SMTP provider (Gmail, SendGrid, Mailgun, etc.).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@searchat-behavior.com

# Base URL of the frontend application, used to build the password reset link.
# Example: https://your-app.example.com
FRONTEND_URL=